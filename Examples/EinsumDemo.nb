Cell["7. Prestazioni", "Section",ExpressionUUID->"ffee252f-a9b4-4426-a043-0c38bcbae961"],

Cell["\<\
Benchmark completo: Get[\"../Examples/Benchmarks.wl\"]. Alcuni confronti \
rapidi:\
\>", "Text",ExpressionUUID->"fa51c547-ca11-496c-ae7b-4554d5269fcf"],

Cell[CellGroupData[{

Cell["\<\
{ba, bb} = RandomReal[1, {2, 20000, 4, 4}];
{First[RepeatedTiming[Einsum[\"bij,bjk->bik\", ba, bb]]], \
First[RepeatedTiming[MapThread[Dot, {ba, bb}]]]}\
\>", "Input",
 CellLabel->"In[54]:=",ExpressionUUID->"a9561c85-2963-43b0-b854-f068e511eac0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.024114625`", ",", "0.012372015625`"}], "}"}]], "Output",
 CellChangeTimes->{4.000783903360018*^9},
 CellLabel->"Out[55]=",ExpressionUUID->"dd9949b1-1253-42f4-bfd8-ed2ecfa99f55"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
{t1, t2, t3} = RandomReal[1, {3, 100, 100, 100}];
{First[RepeatedTiming[Einsum[\"ijk,ijk,ijk->\", t1, t2, t3]]], \
First[RepeatedTiming[Total[t1 t2 t3, 3]]]}\
\>", "Input",
 CellLabel->"In[56]:=",ExpressionUUID->"b84acdc9-a3a3-4633-8c64-58ebc4b5f0ff"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.003526453125`", ",", "0.0027408359375`"}], "}"}]], "Output",
 CellChangeTimes->{4.000783906781877*^9},
 CellLabel->"Out[57]=",ExpressionUUID->"cd640556-7bf5-4190-8eca-1ed4dfc3ca33"]
}, Open  ]],

Cell["EinsumClearCache[]", "Input",
 CellLabel->"In[58]:=",ExpressionUUID->"c04d23ff-999a-45de-899c-3731860fa85d"]
}, Open  ]]
}, Open  ]]
