Cell["7. Performance", "Section",ExpressionUUID->"ffee252f-a9b4-4426-a043-0c38bcbae961"],

Cell["\<\
Full benchmark: Get[\"../Examples/Benchmarks.wl\"]. Some quick comparisons:\
\>", "Text",ExpressionUUID->"fa51c547-ca11-496c-ae7b-4554d5269fcf"],

Cell[CellGroupData[{

Cell["\<\
{ba, bb} = RandomReal[1, {2, 20000, 4, 4}];
{First[RepeatedTiming[Einsum[\"bij,bjk->bik\", ba, bb]]], \
First[RepeatedTiming[MapThread[Dot, {ba, bb}]]]}\
\>", "Input",
 CellLabel->"In[54]:=",ExpressionUUID->"a9561c85-2963-43b0-b854-f068e511eac0"],

