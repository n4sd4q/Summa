Cell[CellGroupData[{

Cell["3. A physics example: norm and observables of an MPS", "Section",ExpressionUUID->"1ffa775e-fe42-43cd-a02b-90c77ebf2ffc"],

Cell["\<\
d = 2; chi = 32;
A1 = RandomReal[1, {d, chi}]; A2 = RandomReal[1, {chi, d, chi}]; A3 = \
RandomReal[1, {chi, d, chi}]; A4 = RandomReal[1, {chi, d}];\
\>", "Input",
 CellLabel->"In[26]:=",ExpressionUUID->"21f8a343-5837-4d94-904a-8edfeaf42896"],

Cell[CellGroupData[{

Cell["\<\
norm = Einsum[\"pa,aqb,brc,cs,pA,AqB,BrC,Cs->\", A1, A2, A3, A4, A1, A2, A3, \
A4]\
\>", "Input",
 CellLabel->"In[28]:=",ExpressionUUID->"b56d5c60-7662-40db-99bd-fe47cc8aa559"],

