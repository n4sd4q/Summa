Cell["\<\
An L\[Times]L grid built in code with the list syntax (labels can be \
expressions):\
\>", "Text",ExpressionUUID->"4cef498a-f1fd-4a58-8f54-3a1b1f231718"],

Cell[CellGroupData[{

Cell["\<\
L = 3;
legs[i_, j_] := Join[If[j > 1, {Subscript[\"h\", i, j - 1]}, {}], If[j < L, \
{Subscript[\"h\", i, j]}, {}],
   If[i > 1, {Subscript[\"v\", i - 1, j]}, {}], If[i < L, {Subscript[\"v\", \
i, j]}, {}], {Subscript[\"p\", i, j]}];
gridSpec = Flatten[Table[legs[i, j], {i, L}, {j, L}], 1] -> \
Flatten[Table[Subscript[\"p\", i, j], {i, L}, {j, L}]];
EinsumDiagram[gridSpec, \"ShowDimensions\" -> False]\
\>", "Input",
 CellLabel->"In[47]:=",ExpressionUUID->"7f2b965a-d857-4904-a22c-5d70a2ea8700"],

