Notebook[{

Cell[CellGroupData[{
Cell["Summa", "Title",ExpressionUUID->"f5da2d9d-9586-42f7-b566-dfe3c152910b"],

Cell["\<\
Fast Einstein summation for Mathematica: indices repeated at will, optimal \
paths, tensor-network diagrams\
\>", "Subtitle",ExpressionUUID->"e2505cab-3bb0-49fb-834a-83ce160bfe00"],

Cell[CellGroupData[{

Cell["Loading", "Section",ExpressionUUID->"bf2f39ea-c609-41a1-87ff-e7f63a67c7e7"],

Cell["\<\
Get[FileNameJoin[{ParentDirectory[NotebookDirectory[]], \"Kernel\", \
\"Summa.wl\"}]]\
\>", "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"929be968-853c-4aa9-bf02-fae301957f9f"],

Cell["\<\
Alternatively: PacletDirectoryLoad[summaFolder]; Needs[\"Summa`\"], or copy \
the folder into $UserBaseDirectory/Applications.\
\>", "Text",ExpressionUUID->"8afd4765-a166-4064-9646-bf0c0db956fc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["1. The basics (numpy syntax)", "Section",ExpressionUUID->"5b984e0e-256f-4ea0-9f8c-47e47e4f7f3b"],

Cell["\<\
a = RandomReal[1, {3, 4}]; b = RandomReal[1, {4, 5}]; m = RandomReal[1, {4, \
4}]; u = RandomReal[1, 3]; v = RandomReal[1, 5];\
\>", "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"bf1a00df-d34e-43fa-9057-f730cc82d865"],

Cell[CellGroupData[{

Cell["Einsum[\"ij,jk->ik\", a, b] == a . b", "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"7f22a5ae-502e-42b0-834b-6c0562b48af5"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{{4.00078388295926*^9, 4.00078389076105*^9}},
 CellLabel->"Out[11]=",ExpressionUUID->"a0c177d6-a0b8-4c8a-bd4c-cf9b4778d7ba"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
{Einsum[\"ii\", m] == Tr[m], Einsum[\"ii->i\", m] == Diagonal[m], \
Einsum[\"ij->ji\", a] == Transpose[a]}\
\>", "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"e8e09018-a3b0-40bb-9e35-457eb84e37e1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellChangeTimes->{{4.000783882979344*^9, 4.0007838907726593`*^9}},
 CellLabel->"Out[12]=",ExpressionUUID->"e13d0b1d-8770-4670-baa9-d364ccf423dc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
{Einsum[\"i,j->ij\", u, v] == Outer[Times, u, v], Einsum[\"ij,jk\", a, b] == \
a . b, Einsum[\"ba\", a] == Transpose[a]}\
\>", "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"1dbb2773-dc9f-4a22-80a4-54d41ae93d59"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellChangeTimes->{{4.0007838829956617`*^9, 4.000783890785483*^9}},
 CellLabel->"Out[13]=",ExpressionUUID->"28486a4f-3225-436e-8bd6-e018a41b882c"]
}, Open  ]],

Cell["List syntax, with any labels (strings, symbols, integers):", "Text",ExpressionUUID->"3863a16a-47be-45d0-a66b-aecf66c4a70e"],

Cell[CellGroupData[{

Cell["\<\
Einsum[{{\"bond\", \"x\"}, {\"x\", \"y\"}} -> {\"y\", \"bond\"}, a, b] == \
Transpose[a . b]\
\>", "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"9329e1a8-d449-430c-8b0a-616feee6d9c3"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{{4.000783883014845*^9, 4.000783890798361*^9}},
 CellLabel->"Out[14]=",ExpressionUUID->"4616a459-439c-4641-8d44-58f3e9139d76"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Einsum[\"\[Alpha]\[Beta],\[Beta]\[Gamma]\[RightArrow]\[Alpha]\[Gamma]\",\
 a, b] == a . b", "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"890f2490-eab5-4cad-8f46-877bedc74725"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{{4.000783883029131*^9, 4.0007838908104963`*^9}},
 CellLabel->"Out[15]=",ExpressionUUID->"52597a11-b380-43aa-a5e8-b74c0a3319db"]
}, Open  ]],

Cell["Ellipsis and broadcasting, as in numpy:", "Text",ExpressionUUID->"bf3c5d43-84a3-4102-99da-9b0043265b67"],

Cell[CellGroupData[{

Cell["\<\
Dimensions[Einsum[\"...ij,...jk->...ik\", RandomReal[1, {7, 3, 4}], b]]\
\>", "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"65f23b82-0e2c-4358-b6ad-379538094916"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"7", ",", "3", ",", "5"}], "}"}]], "Output",
 CellChangeTimes->{{4.0007838830840693`*^9, 4.000783890822584*^9}},
 CellLabel->"Out[16]=",ExpressionUUID->"9555bb70-b956-49cf-9280-e82e42f6996b"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Indices repeated more than twice", "Section",ExpressionUUID->"7d33a762-8e7a-4788-b63e-8161970134aa"],

Cell["\<\
Every index is a COPY tensor: if it appears in three or more places it is a \
hyperedge. In the intermediate contractions it becomes a batch index, with \
nothing to rearrange by hand.\
\>", "Text",ExpressionUUID->"0717276f-f5b2-4620-b32e-02f472e65d3b"],

Cell[CellGroupData[{

Cell["\<\
{x, y, z} = RandomReal[1, {3, 60, 70, 80}];
Einsum[\"ijk,ijk,ijk->\", x, y, z] - Total[x y z, 3]\
\>", "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"32c2f9f4-9ae1-4a53-abc7-9125d002235a"],

Cell[BoxData[
 RowBox[{"-", "9.677023626863956`*^-10"}]], "Output",
 CellChangeTimes->{4.000783890885922*^9},
 CellLabel->"Out[18]=",ExpressionUUID->"27e95410-8861-4fe2-b3a0-09a3fa9cd62c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
{fa, fb, fc} = RandomReal[1, {3, 30, 6}];   (* fattori di una decomposizione \
CP di rango 6 *)
cp = Einsum[\"ai,bi,ci->abc\", fa, fb, fc];
Dimensions[cp]\
\>", "Input",
 CellLabel->"In[19]:=",ExpressionUUID->"3b656ac8-a6aa-4b83-adb8-61cb3c1ed40c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"30", ",", "30", ",", "30"}], "}"}]], "Output",
 CellChangeTimes->{4.000783891018867*^9},
 CellLabel->"Out[21]=",ExpressionUUID->"af9e047d-107c-4a62-98a4-e107b89d19c1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["EinsumDiagram[\"ai,bi,ci->abc\", fa, fb, fc]", "Input",
 CellLabel->"In[22]:=",ExpressionUUID->"47f88aa4-19bf-484c-8246-059245b56ff4"],

